{
  "manifest_version": 3,
  "name": "Chrome ↔ Codex Switcher",
  "version": "0.2.0",
  "description": "Pair Chrome tabs with exact Codex Desktop threads, with persistent floating notes.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:43817/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chrome ↔ Codex contexts"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "switch-twin": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "linux": "Alt+Shift+G"
      },
      "description": "Switch from the active Chrome tab to its Codex twin"
    },
    "link-twin": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "linux": "Alt+Shift+K"
      },
      "description": "Arm the active Chrome tab to link with the next copied Codex deep link"
    },
    "toggle-note": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "linux": "Alt+Shift+V"
      },
      "description": "Show or hide the floating note"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
