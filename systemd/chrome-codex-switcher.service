[Unit]
Description=Chrome-Codex Switcher local bridge
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.local/share/chrome-codex-switcher/host
ExecStart=/usr/bin/python3 -m chrome_codex_switcher.daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
